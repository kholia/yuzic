diff --git a/node_modules/yuzic-engine/android/src/main/cpp/AlacDecoder.cpp b/node_modules/yuzic-engine/android/src/main/cpp/AlacDecoder.cpp
new file mode 100644
--- /dev/null
+++ b/node_modules/yuzic-engine/android/src/main/cpp/AlacDecoder.cpp
@@ -0,0 +1,107 @@
+#include "AlacDecoder.h"
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavutil/error.h>
+#include <libavutil/mem.h>
+#include <libavutil/samplefmt.h>
+}
+#include <cstring>
+#include <stdexcept>
+#include <string>
+
+namespace {
+uint32_t be32(const uint8_t *p) {
+  return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+}
+void check(int result) {
+  if (result >= 0) return;
+  char message[AV_ERROR_MAX_STRING_SIZE];
+  av_strerror(result, message, sizeof(message));
+  throw std::invalid_argument(std::string("ALAC: ") + message);
+}
+}
+
+namespace yuzic {
+AlacDecoder::AlacDecoder(const uint8_t *cookie, size_t size) {
+  if (size != 24) throw std::invalid_argument("Expected 24-byte ALACSpecificConfig");
+  frameLength_ = be32(cookie);
+  channels_ = cookie[9];
+  sampleRate_ = be32(cookie + 20);
+  const unsigned depth = cookie[5];
+  if (!frameLength_ || frameLength_ > 65536 || cookie[4] != 0 || channels_ < 1 || channels_ > 8
+      || (depth != 16 && depth != 20 && depth != 24 && depth != 32)
+      || cookie[8] > 31 || !sampleRate_ || sampleRate_ > 768000) {
+    throw std::invalid_argument("Unsupported ALAC configuration");
+  }
+  try {
+    const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_ALAC);
+    if (!codec) throw std::runtime_error("FFmpeg was built without ALAC");
+    context_ = avcodec_alloc_context3(codec);
+    frame_ = av_frame_alloc();
+    packet_ = av_packet_alloc();
+    if (!context_ || !frame_ || !packet_) throw std::bad_alloc();
+    // Media3 supplies a bare config; FFmpeg expects the surrounding ALAC atom.
+    context_->extradata_size = 36;
+    context_->extradata = static_cast<uint8_t *>(av_mallocz(36 + AV_INPUT_BUFFER_PADDING_SIZE));
+    if (!context_->extradata) throw std::bad_alloc();
+    const uint8_t header[12] = {0, 0, 0, 36, 'a', 'l', 'a', 'c', 0, 0, 0, 0};
+    std::memcpy(context_->extradata, header, 12);
+    std::memcpy(context_->extradata + 12, cookie, 24);
+    context_->thread_count = 1;
+    context_->err_recognition = AV_EF_CAREFUL | AV_EF_EXPLODE;
+    check(avcodec_open2(context_, codec, nullptr));
+    if (context_->ch_layout.nb_channels != int(channels_) || context_->sample_rate != int(sampleRate_)) {
+      throw std::invalid_argument("ALAC configuration does not match decoder output");
+    }
+  } catch (...) {
+    av_packet_free(&packet_);
+    av_frame_free(&frame_);
+    avcodec_free_context(&context_);
+    throw;
+  }
+}
+
+AlacDecoder::~AlacDecoder() {
+  av_packet_free(&packet_);
+  av_frame_free(&frame_);
+  avcodec_free_context(&context_);
+}
+
+void AlacDecoder::flush() { avcodec_flush_buffers(context_); }
+
+size_t AlacDecoder::decode(const uint8_t *input, size_t size, uint8_t *pcm, size_t capacity) {
+  if (!size || size > size_t(frameLength_) * channels_ * 4 + 65536 || capacity < maxOutputBytes()) {
+    throw std::invalid_argument("Invalid ALAC buffer size");
+  }
+  av_packet_unref(packet_);
+  av_frame_unref(frame_);
+  // av_new_packet supplies FFmpeg's required zero padding, including after a
+  // seek to a shorter final packet. Media3's direct input has no such guarantee.
+  check(av_new_packet(packet_, static_cast<int>(size)));
+  std::memcpy(packet_->data, input, size);
+  check(avcodec_send_packet(context_, packet_));
+  check(avcodec_receive_frame(context_, frame_));
+  if (frame_->nb_samples <= 0 || frame_->nb_samples > int(frameLength_)
+      || frame_->ch_layout.nb_channels != int(channels_) || frame_->sample_rate != int(sampleRate_)
+      || (frame_->format != AV_SAMPLE_FMT_S16P && frame_->format != AV_SAMPLE_FMT_S32P)) {
+    throw std::invalid_argument("Unexpected ALAC output format");
+  }
+  // FFmpeg puts channels in the standard speaker order, including multichannel
+  // ALAC's different packet ordering. Interleave directly into Media3's output.
+  // The graph's EQ/fade processors require PCM16, also for hi-res sources.
+  for (int sample = 0; sample < frame_->nb_samples; ++sample) {
+    for (unsigned channel = 0; channel < channels_; ++channel) {
+      uint16_t value;
+      if (frame_->format == AV_SAMPLE_FMT_S16P) {
+        value = reinterpret_cast<const uint16_t *>(frame_->extended_data[channel])[sample];
+      } else {
+        value = static_cast<uint16_t>(reinterpret_cast<const uint32_t *>(frame_->extended_data[channel])[sample] >> 16);
+      }
+      const size_t offset = (size_t(sample) * channels_ + channel) * 2;
+      pcm[offset] = static_cast<uint8_t>(value);
+      pcm[offset + 1] = static_cast<uint8_t>(value >> 8);
+    }
+  }
+  return size_t(frame_->nb_samples) * channels_ * 2;
+}
+}
diff --git a/node_modules/yuzic-engine/android/src/main/cpp/AlacDecoder.h b/node_modules/yuzic-engine/android/src/main/cpp/AlacDecoder.h
new file mode 100644
--- /dev/null
+++ b/node_modules/yuzic-engine/android/src/main/cpp/AlacDecoder.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+struct AVCodecContext;
+struct AVFrame;
+struct AVPacket;
+
+namespace yuzic {
+// One context per Media3 decoder/voice. No shared mutable codec state.
+class AlacDecoder {
+ public:
+  explicit AlacDecoder(const uint8_t *cookie, size_t size);
+  ~AlacDecoder();
+  AlacDecoder(const AlacDecoder &) = delete;
+  AlacDecoder &operator=(const AlacDecoder &) = delete;
+  size_t decode(const uint8_t *packet, size_t size, uint8_t *pcm, size_t capacity);
+  void flush();
+  uint32_t channels() const { return channels_; }
+  uint32_t sampleRate() const { return sampleRate_; }
+  size_t maxOutputBytes() const { return size_t(frameLength_) * channels_ * 2; }
+ private:
+  AVCodecContext *context_ = nullptr;
+  AVFrame *frame_ = nullptr;
+  AVPacket *packet_ = nullptr;
+  uint32_t channels_, sampleRate_, frameLength_;
+};
+}
diff --git a/node_modules/yuzic-engine/android/src/main/cpp/AlacJni.cpp b/node_modules/yuzic-engine/android/src/main/cpp/AlacJni.cpp
new file mode 100644
--- /dev/null
+++ b/node_modules/yuzic-engine/android/src/main/cpp/AlacJni.cpp
@@ -0,0 +1,45 @@
+#include "AlacDecoder.h"
+#include <jni.h>
+#include <stdexcept>
+
+static void fail(JNIEnv *env, const char *message) {
+  env->ThrowNew(env->FindClass("java/lang/IllegalArgumentException"), message);
+}
+
+extern "C" JNIEXPORT jlong JNICALL
+Java_dev_yuzic_engine_NativeAlacDecoder_create(JNIEnv *env, jclass, jbyteArray config) {
+  if (!config || env->GetArrayLength(config) != 24) {
+    fail(env, "Expected 24-byte ALAC configuration"); return 0;
+  }
+  uint8_t cookie[24];
+  env->GetByteArrayRegion(config, 0, 24, reinterpret_cast<jbyte *>(cookie));
+  if (env->ExceptionCheck()) return 0;
+  try { return reinterpret_cast<jlong>(new yuzic::AlacDecoder(cookie, 24)); }
+  catch (const std::exception &error) { fail(env, error.what()); return 0; }
+}
+
+extern "C" JNIEXPORT jint JNICALL
+Java_dev_yuzic_engine_NativeAlacDecoder_decode(JNIEnv *env, jclass, jlong handle,
+    jobject input, jint offset, jint size, jobject output, jint capacity) {
+  auto *decoder = reinterpret_cast<yuzic::AlacDecoder *>(handle);
+  auto *in = static_cast<uint8_t *>(env->GetDirectBufferAddress(input));
+  auto *out = static_cast<uint8_t *>(env->GetDirectBufferAddress(output));
+  jlong inCapacity = env->GetDirectBufferCapacity(input);
+  jlong outCapacity = env->GetDirectBufferCapacity(output);
+  if (!decoder || !in || !out || offset < 0 || size < 0 || capacity < 0
+      || jlong(offset) + size > inCapacity || capacity > outCapacity) {
+    fail(env, "Invalid ALAC direct buffers"); return 0;
+  }
+  try { return static_cast<jint>(decoder->decode(in + offset, size, out, capacity)); }
+  catch (const std::exception &error) { fail(env, error.what()); return 0; }
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_dev_yuzic_engine_NativeAlacDecoder_destroy(JNIEnv *, jclass, jlong handle) {
+  delete reinterpret_cast<yuzic::AlacDecoder *>(handle);
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_dev_yuzic_engine_NativeAlacDecoder_flush(JNIEnv *, jclass, jlong handle) {
+  reinterpret_cast<yuzic::AlacDecoder *>(handle)->flush();
+}
diff --git a/node_modules/yuzic-engine/android/src/main/cpp/AlacProbe.cpp b/node_modules/yuzic-engine/android/src/main/cpp/AlacProbe.cpp
new file mode 100644
--- /dev/null
+++ b/node_modules/yuzic-engine/android/src/main/cpp/AlacProbe.cpp
@@ -0,0 +1,30 @@
+#include "AlacDecoder.h"
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+static uint32_t readSize(std::istream &input) {
+  uint8_t bytes[4];
+  if (!input.read(reinterpret_cast<char *>(bytes), 4)) throw std::runtime_error("Truncated packet file");
+  return uint32_t(bytes[0]) << 24 | uint32_t(bytes[1]) << 16 | uint32_t(bytes[2]) << 8 | bytes[3];
+}
+int main(int argc, char **argv) {
+  if (argc != 3) { std::cerr << "Usage: alac_probe packets output.pcm\n"; return 2; }
+  try {
+    std::ifstream input(argv[1], std::ios::binary);
+    std::ofstream output(argv[2], std::ios::binary);
+    uint8_t config[24];
+    if (!input.read(reinterpret_cast<char *>(config), 24)) throw std::runtime_error("Missing config");
+    yuzic::AlacDecoder decoder(config, 24);
+    std::vector<uint8_t> pcm(decoder.maxOutputBytes());
+    for (uint32_t size; (size = readSize(input)) != UINT32_MAX;) {
+      if (size > 4 * 1024 * 1024) throw std::runtime_error("Packet too large");
+      std::vector<uint8_t> packet(size);
+      if (!input.read(reinterpret_cast<char *>(packet.data()), size)) throw std::runtime_error("Truncated packet");
+      size_t decoded = decoder.decode(packet.data(), packet.size(), pcm.data(), pcm.size());
+      output.write(reinterpret_cast<const char *>(pcm.data()), decoded);
+    }
+    if (!output) throw std::runtime_error("Cannot write PCM");
+  } catch (const std::exception &error) { std::cerr << error.what() << '\n'; return 1; }
+}
diff --git a/node_modules/yuzic-engine/android/src/main/cpp/AlacTest.cpp b/node_modules/yuzic-engine/android/src/main/cpp/AlacTest.cpp
